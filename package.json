{
  "name": "course-review-desk",
  "version": "1.2.1",
  "private": true,
  "description": "离线课程阅读与复习管理",
  "author": "troulierkilian-blip",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "pack": "electron-builder --win portable --x64",
    "pack:dir": "electron-builder --win dir --x64",
    "test:desktop": "node scripts/smoke.mjs",
    "test:ai": "node scripts/ai-smoke.mjs",
    "test:portable": "node scripts/portable-smoke.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "io.github.troulierkilianblip.coursereviewdesk",
    "productName": "课程复习助手",
    "directories": {
      "output": "release/v1.2.1",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundled",
        "to": "bundled"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "npmRebuild": true,
    "portable": {
      "artifactName": "CourseReviewDesk-v${version}-win-x64.${ext}",
      "requestExecutionLevel": "user"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE-CourseReviewDesk.txt"
      }
    ]
  },
  "overrides": {
    "katex": "$katex"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/troulierkilian-blip/course-review-desk.git"
  }
}
